    "    ),\n",
    "    \"validation_average_precision\": float(\n",
    "        average_precision_score(y_val, rf_val_probabilities)\n",
    "    ),\n",
    "    \"model_parameters\": rf_model.get_params(),\n",
    "    \"test_set_evaluated\": False\n",
    "}\n",
    "\n",
    "with open(results_dir / \"rf_settings.json\", \"w\") as file:\n",
    "    json.dump(rf_settings, file, indent=2)\n",
    "\n",
    "print(\"Random Forest settings saved.\")"
   ]
  },
