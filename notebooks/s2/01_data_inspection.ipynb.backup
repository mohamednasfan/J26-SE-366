   "source": [
    "import pandas as pd\n",
    "\n",
    "drugbank = pd.read_csv(\"drugbank.csv\")\n",
    "biosnap = pd.read_csv(\"biosnap.csv\")\n",
    "\n",
    "print(\"DrugBank:\", drugbank.shape)\n",
    "print(\"BIOSNAP:\", biosnap.shape)\n",
    "\n",
    "display(drugbank.head())\n",
    "display(biosnap.head())"
   ]
  },
