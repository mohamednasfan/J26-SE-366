       "   drug_id                                      smiles\n",
       "0  DB04571         CC1=CC2=CC3=C(OC(=O)C=C3C)C(C)=C2O1\n",
       "1  DB00855                             NCC(=O)CCC(O)=O\n",
       "2  DB09536                                    O=[Ti]=O\n",
       "3  DB01600       CC(C(O)=O)C1=CC=C(S1)C(=O)C1=CC=CC=C1\n",
