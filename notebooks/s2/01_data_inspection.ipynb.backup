   ],
   "source": [
    "import numpy as np\n",
    "from rdkit.Chem import rdFingerprintGenerator\n",
    "\n",
    "# Fixed settings for reproducible molecular features\n",
    "fingerprint_generator = rdFingerprintGenerator.GetMorganGenerator(\n",
    "    radius=2,\n",
    "    fpSize=2048\n",
    ")\n",
    "\n",
    "# Compute each drug's fingerprint once\n",
    "fingerprints = {}\n",
    "\n",
    "for row in valid_drugs.itertuples(index=False):\n",
    "    fingerprints[row.drug_id] = (\n",
    "        fingerprint_generator.GetFingerprintAsNumPy(row.molecule)\n",
    "        .astype(np.uint8)\n",
    "    )\n",
    "\n",
    "print(\"Drugs with fingerprints:\", len(fingerprints))\n",
    "\n",
    "example_id = next(iter(fingerprints))\n",
    "example_fp = fingerprints[example_id]\n",
    "\n",
    "print(\"Example drug:\", example_id)\n",
    "print(\"Fingerprint length:\", len(example_fp))\n",
    "print(\"First 30 values:\", example_fp[:30])\n",
    "\n",
    "# Verify the generated features\n",
    "assert all(fp.shape == (2048,) for fp in fingerprints.values())\n",
    "assert all(np.isin(fp, [0, 1]).all() for fp in fingerprints.values())\n",
    "\n",
    "print(\"\\nFingerprint checks passed.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "9a4156e2-f4ec-4765-a050-169502f7503c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Positive pairs: 196293\n",
      "Sampled unknown pairs: 196293\n",
      "Total pairs: 392586\n",
      "\n",
      "Class counts:\n",
      "interaction\n",
      "1    196293\n",
      "0    196293\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "from itertools import combinations\n",
    "import random\n",
    "\n",
    "SEED = 42\n",
    "\n",
    "# Exclude every known interaction from both original datasets\n",
    "known_pairs = {\n",
    "    tuple(sorted((a, b)))\n",
    "    for a, b in positive_pairs[\n",
    "        [\"drug1_id\", \"drug2_id\"]\n",
    "    ].itertuples(index=False, name=None)\n",
    "}\n",
    "\n",
    "# Use drugs represented in the usable positive dataset\n",
    "eligible_drugs = sorted(\n",
    "    set(usable_positive_pairs[\"drug1_id\"])\n",
    "    | set(usable_positive_pairs[\"drug2_id\"])\n",
    ")\n",
    "\n",
    "# Build candidate unknown pairs:\n",
    "# no self-pairs, reversed duplicates, or known positive pairs\n",
    "unknown_candidates = [\n",
    "    pair\n",
    "    for pair in combinations(eligible_drugs, 2)\n",
    "    if pair not in known_pairs\n",
    "]\n",
    "\n",
    "number_needed = len(usable_positive_pairs)\n",
    "\n",
    "if len(unknown_candidates) < number_needed:\n",
    "    raise ValueError(\"Not enough unknown pairs for a 1:1 sample.\")\n",
    "\n",
    "sampled_pairs = random.Random(SEED).sample(\n",
    "    unknown_candidates,\n",
    "    number_needed\n",
    ")\n",
    "\n",
    "negative_pairs = pd.DataFrame(\n",
    "    sampled_pairs,\n",
    "    columns=[\"drug1_id\", \"drug2_id\"]\n",
    ")\n",
    "negative_pairs[\"interaction\"] = 0\n",
    "negative_pairs[\"source\"] = \"sampled_unknown\"\n",
    "\n",
    "# Combine and shuffle\n",
    "binary_dataset = pd.concat(\n",
    "    [usable_positive_pairs, negative_pairs],\n",
    "    ignore_index=True\n",
    ").sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
    "\n",
    "# Verify that sampled negatives contain no known positives\n",
    "assert not (set(sampled_pairs) & known_pairs)\n",
    "assert binary_dataset.duplicated(\n",
    "    [\"drug1_id\", \"drug2_id\"]\n",
    ").sum() == 0\n",
    "\n",
    "print(\"Positive pairs:\", len(usable_positive_pairs))\n",
    "print(\"Sampled unknown pairs:\", len(negative_pairs))\n",
    "print(\"Total pairs:\", len(binary_dataset))\n",
    "print(\"\\nClass counts:\")\n",
    "print(binary_dataset[\"interaction\"].value_counts())\n",
    "\n",
    "# Release the candidate list to save memory\n",
    "del unknown_candidates"
   ]
  },
