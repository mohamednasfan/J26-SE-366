   "source": [
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score,\n",
    "    roc_auc_score,\n",
    "    average_precision_score,\n",
    "    confusion_matrix\n",
    ")\n",
    "\n",
    "# Prepare validation features using the same method as training\n",
    "X_val = build_pair_features(val_pairs)\n",
    "y_val = val_pairs[\"interaction\"].to_numpy(dtype=np.int8)\n",
    "\n",
    "# Predict interaction scores and classes\n",
    "val_probabilities = lr_model.predict_proba(X_val)[:, 1]\n",
    "val_predictions = (val_probabilities >= 0.5).astype(int)\n",
    "\n",
    "print(\"VALIDATION RESULTS â€” threshold 0.5\")\n",
    "print(f\"Accuracy:          {accuracy_score(y_val, val_predictions):.4f}\")\n",
    "print(f\"Precision:         {precision_score(y_val, val_predictions, zero_division=0):.4f}\")\n",
    "print(f\"Recall:            {recall_score(y_val, val_predictions, zero_division=0):.4f}\")\n",
    "print(f\"F1-score:          {f1_score(y_val, val_predictions, zero_division=0):.4f}\")\n",
    "print(f\"ROC-AUC:           {roc_auc_score(y_val, val_probabilities):.4f}\")\n",
    "print(f\"Average precision: {average_precision_score(y_val, val_probabilities):.4f}\")\n",
    "\n",
    "matrix = confusion_matrix(y_val, val_predictions, labels=[0, 1])\n",
    "\n",
    "display(pd.DataFrame(\n",
    "    matrix,\n",
    "    index=[\"Actual sampled unknown\", \"Actual known interaction\"],\n",
    "    columns=[\"Predicted 0\", \"Predicted 1\"]\n",
    "))"
   ]
  },
