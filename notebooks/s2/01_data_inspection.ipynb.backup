   ],
   "source": [
    "import copy\n",
    "import time\n",
    "\n",
    "# Balanced supervision targets from the training split only\n",
    "gnn_unknown_targets = training_unknowns.sample(\n",
    "    n=len(supervision_positives),\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "gnn_training_pairs = pd.concat(\n",
    "    [supervision_positives, gnn_unknown_targets],\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "train_target_pairs = node_pairs(gnn_training_pairs)\n",
    "train_target_labels = torch.tensor(\n",
    "    gnn_training_pairs[\"interaction\"].to_numpy(),\n",
    "    dtype=torch.float32\n",
    ")\n",
    "\n",
    "validation_target_pairs = node_pairs(val_pairs)\n",
    "\n",
    "optimizer = torch.optim.Adam(\n",
    "    gnn_model.parameters(),\n",
    "    lr=0.001,\n",
    "    weight_decay=1e-4\n",
    ")\n",
    "\n",
    "loss_function = nn.BCEWithLogitsLoss()\n",
    "\n",
    "best_auc = -float(\"inf\")\n",
    "best_state = None\n",
    "best_epoch = 0\n",
    "epochs_without_improvement = 0\n",
    "patience = 15\n",
    "gnn_history = []\n",
    "\n",
    "start_time = time.time()\n",
    "\n",
    "for epoch in range(1, 101):\n",
    "    # Train\n",
    "    gnn_model.train()\n",
    "    optimizer.zero_grad()\n",
    "\n",
    "    embeddings = gnn_model.encode(node_features, edge_index)\n",
    "    logits = gnn_model.decode(embeddings, train_target_pairs)\n",
    "    loss = loss_function(logits, train_target_labels)\n",
    "\n",
    "    loss.backward()\n",
    "    optimizer.step()\n",
    "\n",
    "    # Validate using the same training graph\n",
    "    gnn_model.eval()\n",
    "\n",
    "    with torch.no_grad():\n",
    "        embeddings = gnn_model.encode(node_features, edge_index)\n",
    "        val_logits = gnn_model.decode(\n",
    "            embeddings, validation_target_pairs\n",
    "        )\n",
    "        probabilities = torch.sigmoid(val_logits).cpu().numpy()\n",
    "\n",
    "    val_auc = roc_auc_score(y_val, probabilities)\n",
    "\n",
    "    gnn_history.append({\n",
    "        \"epoch\": epoch,\n",
    "        \"training_loss\": loss.item(),\n",
    "        \"validation_roc_auc\": val_auc\n",
    "    })\n",
    "\n",
    "    if val_auc > best_auc + 1e-5:\n",
    "        best_auc = val_auc\n",
    "        best_epoch = epoch\n",
    "        best_state = copy.deepcopy(gnn_model.state_dict())\n",
    "        epochs_without_improvement = 0\n",
    "    else:\n",
    "        epochs_without_improvement += 1\n",
    "\n",
    "    if epoch == 1 or epoch % 5 == 0:\n",
    "        print(\n",
    "            f\"Epoch {epoch:3d} | \"\n",
    "            f\"Loss: {loss.item():.4f} | \"\n",
    "            f\"Validation ROC-AUC: {val_auc:.4f}\",\n",
    "            flush=True\n",
    "        )\n",
    "\n",
    "    if epochs_without_improvement >= patience:\n",
    "        print(\"Early stopping triggered.\")\n",
    "        break\n",
    "\n",
    "# Restore the best validation checkpoint\n",
    "gnn_model.load_state_dict(best_state)\n",
    "gnn_model.eval()\n",
    "\n",
    "torch.save(\n",
    "    {\n",
    "        \"model_state_dict\": best_state,\n",
    "        \"drug_ids\": gnn_drug_ids,\n",
    "        \"node_features\": node_features,\n",
    "        \"edge_index\": edge_index,\n",
    "        \"best_epoch\": best_epoch,\n",
    "        \"best_validation_auc\": best_auc\n",
    "    },\n",
    "    model_dir / \"gnn_checkpoint.pt\"\n",
    ")\n",
    "\n",
    "pd.DataFrame(gnn_history).to_csv(\n",
    "    results_dir / \"gnn_training_history.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(f\"\\nTraining time: {time.time() - start_time:.1f} seconds\")\n",
    "print(\"Best epoch:\", best_epoch)\n",
    "print(\"Best validation ROC-AUC:\", round(best_auc, 4))\n",
    "print(\"GNN checkpoint saved.\")"
   ]
  },
