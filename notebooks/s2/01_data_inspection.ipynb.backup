      "[850]\tvalidation_0-auc:0.88546\n",
      "[900]\tvalidation_0-auc:0.88717\n",
      "[950]\tvalidation_0-auc:0.88887\n",
      "[999]\tvalidation_0-auc:0.89080\n",
      "\n",
      "Training time: 2794.6 seconds\n",
      "Best boosting round: 1000\n",
      "Best validation ROC-AUC: 0.8907988478576672\n",
      "XGBoost model saved successfully.\n"
     ]
