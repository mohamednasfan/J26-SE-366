     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cold-start training features: (190916, 4096)\n",
      "Cold-start validation features: (84628, 4096)\n",
      "Cold-start features saved successfully.\n"
     ]
    }
   ],
   "source": [
    "# Features for the separate cold-start experiment\n",
    "X_cold_train = build_pair_features(cold_train_pairs)\n",
    "y_cold_train = cold_train_pairs[\"interaction\"].to_numpy(\n",
    "    dtype=np.int8\n",
    ")\n",
    "\n",
    "X_cold_val = build_pair_features(cold_val_pairs)\n",
    "y_cold_val = cold_val_pairs[\"interaction\"].to_numpy(\n",
    "    dtype=np.int8\n",
    ")\n",
    "\n",
    "print(\"Cold-start training features:\", X_cold_train.shape)\n",
    "print(\"Cold-start validation features:\", X_cold_val.shape)\n",
    "\n",
    "assert X_cold_train.shape == (190916, 4096)\n",
    "assert X_cold_val.shape == (84628, 4096)\n",
    "\n",
    "# Save features and matching labels\n",
    "save_npz(cold_output_dir / \"X_train.npz\", X_cold_train)\n",
    "np.save(cold_output_dir / \"y_train.npy\", y_cold_train)\n",
    "\n",
    "save_npz(cold_output_dir / \"X_validation.npz\", X_cold_val)\n",
    "np.save(cold_output_dir / \"y_validation.npy\", y_cold_val)\n",
    "\n",
    "print(\"Cold-start features saved successfully.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "e655987a-6358-4f34-aa3c-2ec43db9966e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training time: 141.1 seconds\n",
      "Iterations used: 529\n",
      "Converged: True\n",
      "Cold-start Logistic Regression saved.\n"
     ]
    }
   ],
   "source": [
    "import warnings\n",
    "from sklearn.exceptions import ConvergenceWarning\n",
    "\n",
    "cold_model_dir = Path(\"models/cold_start\")\n",
    "cold_model_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "cold_lr_model = LogisticRegression(\n",
    "    solver=\"saga\",\n",
    "    max_iter=3000,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "start_time = time.time()\n",
    "\n",
    "with warnings.catch_warnings(record=True) as recorded_warnings:\n",
    "    warnings.simplefilter(\"always\", ConvergenceWarning)\n",
    "\n",
    "    cold_lr_model.fit(X_cold_train, y_cold_train)\n",
    "\n",
    "convergence_failed = any(\n",
    "    issubclass(w.category, ConvergenceWarning)\n",
    "    for w in recorded_warnings\n",
    ")\n",
    "\n",
    "print(f\"Training time: {time.time() - start_time:.1f} seconds\")\n",
    "print(\"Iterations used:\", cold_lr_model.n_iter_[0])\n",
    "print(\"Converged:\", not convergence_failed)\n",
    "\n",
    "joblib.dump(\n",
    "    cold_lr_model,\n",
    "    cold_model_dir / \"logistic_regression.joblib\"\n",
    ")\n",
    "\n",
    "print(\"Cold-start Logistic Regression saved.\")"
   ]
  },
