   "source": [
    "# 1. Check missing values\n",
    "print(\"DrugBank â€” missing values:\")\n",
    "print(drugbank.isna().sum())\n",
    "\n",
    "print(\"\\nBIOSNAP â€” missing values:\")\n",
    "print(biosnap.isna().sum())\n",
    "\n",
    "# 2. Check exact duplicate rows\n",
    "print(\"\\nDrugBank duplicate rows:\", drugbank.duplicated().sum())\n",
