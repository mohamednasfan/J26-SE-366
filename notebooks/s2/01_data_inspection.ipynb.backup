   "source": [
    "# Create a separate copy for structure checking\n",
    "checked_mapping = drug_mapping.copy()\n",
    "\n",
    "# Convert each SMILES string into an RDKit molecule\n",
    "checked_mapping[\"molecule\"] = checked_mapping[\"smiles\"].apply(\n",
    "    Chem.MolFromSmiles\n",
    ")\n",
    "\n",
    "valid_mask = checked_mapping[\"molecule\"].notna()\n",
    "\n",
    "valid_drugs = checked_mapping[valid_mask].copy()\n",
    "invalid_drugs = checked_mapping[~valid_mask].copy()\n",
    "\n",
    "print(\"Valid structures:\", len(valid_drugs))\n",
    "print(\"Invalid structures:\", len(invalid_drugs))\n",
    "\n",
    "if len(invalid_drugs) > 0:\n",
    "    display(invalid_drugs[[\"drug_id\", \"smiles\"]])\n",
    "\n",
    "# Keep pairs where both drugs have readable structures.\n",
    "# Preserve positive_pairs as the complete original merged dataset.\n",
    "valid_ids = set(valid_drugs[\"drug_id\"])\n",
    "\n",
    "usable_positive_pairs = positive_pairs[\n",
    "    positive_pairs[\"drug1_id\"].isin(valid_ids)\n",
    "    & positive_pairs[\"drug2_id\"].isin(valid_ids)\n",
    "].copy()\n",
    "\n",
    "print(\"\\nOriginal positive pairs:\", len(positive_pairs))\n",
    "print(\"Pairs with valid structures:\", len(usable_positive_pairs))\n",
    "print(\n",
    "    \"Pairs excluded due to missing or invalid structures:\",\n",
    "    len(positive_pairs) - len(usable_positive_pairs)\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
