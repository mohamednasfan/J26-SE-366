   "source": [
    "from sklearn.metrics import precision_recall_curve\n",
    "\n",
    "model_scores = {\n",
    "    \"Logistic Regression\": val_probabilities,\n",
    "    \"Random Forest\": rf_val_probabilities,\n",
    "    \"XGBoost\": xgb_val_probabilities,\n",
    "    \"GNN\": gnn_val_probabilities\n",
    "}\n",
    "\n",
    "selected_thresholds = {}\n",
    "comparison_rows = []\n",
    "\n",
    "for name, scores in model_scores.items():\n",
    "    precision, recall, thresholds = precision_recall_curve(\n",
    "        y_val, scores\n",
    "    )\n",
    "\n",
    "    # The final precision/recall point has no threshold\n",
    "    f1_values = (\n",
    "        2 * precision[:-1] * recall[:-1]\n",
    "        / np.maximum(precision[:-1] + recall[:-1], 1e-12)\n",
    "    )\n",
    "\n",
    "    best_index = int(np.argmax(f1_values))\n",
    "    threshold = float(thresholds[best_index])\n",
    "    selected_thresholds[name] = threshold\n",
    "\n",
    "    predictions = (scores >= threshold).astype(int)\n",
    "\n",
    "    comparison_rows.append({\n",
    "        \"model\": name,\n",
    "        \"threshold\": threshold,\n",
    "        \"precision\": precision_score(\n",
    "            y_val, predictions, zero_division=0\n",
    "        ),\n",
    "        \"recall\": recall_score(\n",
    "            y_val, predictions, zero_division=0\n",
    "        ),\n",
    "        \"F1\": f1_score(y_val, predictions, zero_division=0),\n",
    "        \"ROC_AUC\": roc_auc_score(y_val, scores),\n",
    "        \"average_precision\": average_precision_score(\n",
    "            y_val, scores\n",
    "        )\n",
    "    })\n",
    "\n",
    "validation_comparison = pd.DataFrame(comparison_rows)\n",
    "display(validation_comparison.round(4))\n",
    "\n",
    "validation_comparison.to_csv(\n",
    "    results_dir / \"validation_model_comparison.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "with open(results_dir / \"selected_thresholds.json\", \"w\") as file:\n",
    "    json.dump({\n",
    "        \"selection_rule\": \"Maximum validation F1 on precision-recall curve\",\n",
    "        \"thresholds\": selected_thresholds\n",
    "    }, file, indent=2)\n",
    "\n",
    "print(\"Updated validation thresholds saved.\")"
   ]
  },
