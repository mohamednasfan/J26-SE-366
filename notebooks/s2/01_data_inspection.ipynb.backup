   "source": [
    "from sklearn.linear_model import LogisticRegression\n",
    "import time\n",
    "import joblib\n",
    "\n",
    "# Create the baseline model\n",
    "lr_model = LogisticRegression(\n",
    "    solver=\"saga\",\n",
    "    max_iter=1000,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "# Train using training data only\n",
    "start_time = time.time()\n",
    "\n",
    "lr_model.fit(X_train, y_train)\n",
    "\n",
    "print(f\"Training time: {time.time() - start_time:.1f} seconds\")\n",
    "print(\"Iterations used:\", lr_model.n_iter_[0])\n",
    "\n",
    "# Save the trained model\n",
    "model_dir = Path(\"models\")\n",
    "model_dir.mkdir(exist_ok=True)\n",
    "\n",
    "joblib.dump(lr_model, model_dir / \"logistic_regression.joblib\")\n",
    "\n",
    "print(\"Model saved successfully.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "659bc865-96b8-483b-9256-1c912458468b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Additional training time: 55.4 seconds\n",
      "Iterations in this run: 136\n",
      "Converged: True\n",
      "Updated model saved.\n"
     ]
    }
   ],
   "source": [
    "import time\n",
    "import warnings\n",
    "from sklearn.exceptions import ConvergenceWarning\n",
    "\n",
    "# Reuse the coefficients already learned\n",
    "lr_model.set_params(\n",
    "    warm_start=True,\n",
    "    max_iter=3000\n",
    ")\n",
    "\n",
    "start_time = time.time()\n",
    "\n",
    "with warnings.catch_warnings(record=True) as recorded_warnings:\n",
    "    warnings.simplefilter(\"always\", ConvergenceWarning)\n",
    "    lr_model.fit(X_train, y_train)\n",
    "\n",
    "convergence_failed = any(\n",
    "    issubclass(w.category, ConvergenceWarning)\n",
    "    for w in recorded_warnings\n",
    ")\n",
    "\n",
    "print(f\"Additional training time: {time.time() - start_time:.1f} seconds\")\n",
    "print(\"Iterations in this run:\", lr_model.n_iter_[0])\n",
    "print(\"Converged:\", not convergence_failed)\n",
    "\n",
    "joblib.dump(\n",
    "    lr_model,\n",
    "    model_dir / \"logistic_regression.joblib\"\n",
    ")\n",
    "\n",
    "print(\"Updated model saved.\")"
   ]
  },
