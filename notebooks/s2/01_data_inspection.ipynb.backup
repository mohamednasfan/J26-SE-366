    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cold-start validation results saved.\n"
     ]
    }
   ],
   "source": [
    "# Predict on cold-start validation pairs\n",
    "cold_lr_val_scores = cold_lr_model.predict_proba(X_cold_val)[:, 1]\n",
    "\n",
    "# Select a threshold using validation F1\n",
    "precision, recall, thresholds = precision_recall_curve(\n",
    "    y_cold_val, cold_lr_val_scores\n",
    ")\n",
    "\n",
    "f1_values = (\n",
    "    2 * precision[:-1] * recall[:-1]\n",
    "    / np.maximum(precision[:-1] + recall[:-1], 1e-12)\n",
    ")\n",
    "\n",
    "best_index = int(np.argmax(f1_values))\n",
    "cold_lr_threshold = float(thresholds[best_index])\n",
    "\n",
    "predictions = (\n",
    "    cold_lr_val_scores >= cold_lr_threshold\n",
    ").astype(int)\n",
    "\n",
    "cold_lr_metrics = {\n",
    "    \"model\": \"Logistic Regression\",\n",
    "    \"threshold\": cold_lr_threshold,\n",
    "    \"accuracy\": accuracy_score(y_cold_val, predictions),\n",
    "    \"precision\": precision_score(\n",
    "        y_cold_val, predictions, zero_division=0\n",
    "    ),\n",
    "    \"recall\": recall_score(\n",
    "        y_cold_val, predictions, zero_division=0\n",
    "    ),\n",
    "    \"F1\": f1_score(y_cold_val, predictions, zero_division=0),\n",
    "    \"ROC_AUC\": roc_auc_score(y_cold_val, cold_lr_val_scores),\n",
    "    \"average_precision\": average_precision_score(\n",
    "        y_cold_val, cold_lr_val_scores\n",
    "    )\n",
    "}\n",
    "\n",
    "display(pd.DataFrame([cold_lr_metrics]).round(4))\n",
    "\n",
    "display(pd.DataFrame(\n",
    "    confusion_matrix(y_cold_val, predictions, labels=[0, 1]),\n",
    "    index=[\"Actual sampled unknown\", \"Actual known interaction\"],\n",
    "    columns=[\"Predicted 0\", \"Predicted 1\"]\n",
    "))\n",
    "\n",
    "# Save separately from the standard experiment\n",
    "cold_results_dir = Path(\"results/cold_start\")\n",
    "cold_results_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "pd.DataFrame([cold_lr_metrics]).to_csv(\n",
    "    cold_results_dir / \"lr_validation_metrics.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "with open(cold_results_dir / \"lr_settings.json\", \"w\") as file:\n",
    "    json.dump({\n",
    "        \"selected_threshold\": cold_lr_threshold,\n",
    "        \"selection_rule\": \"Maximum cold-start validation F1\",\n",
    "        \"protocol\": \"one_unseen_drug\",\n",
    "        \"test_set_evaluated\": False\n",
    "    }, file, indent=2)\n",
    "\n",
    "print(\"Cold-start validation results saved.\")"
   ]
  },
