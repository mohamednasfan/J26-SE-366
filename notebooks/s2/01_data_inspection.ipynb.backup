   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# Reserve 30% for validation and testing\n",
    "train_pairs, remaining_pairs = train_test_split(\n",
    "    binary_dataset,\n",
    "    test_size=0.30,\n",
    "    stratify=binary_dataset[\"interaction\"],\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "# Divide the remaining 30% equally\n",
    "val_pairs, test_pairs = train_test_split(\n",
    "    remaining_pairs,\n",
    "    test_size=0.50,\n",
    "    stratify=remaining_pairs[\"interaction\"],\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "# Check that no pair appears in more than one split\n",
    "def pair_set(data):\n",
    "    return set(\n",
    "        data[[\"drug1_id\", \"drug2_id\"]]\n",
    "        .itertuples(index=False, name=None)\n",
    "    )\n",
    "\n",
    "assert pair_set(train_pairs).isdisjoint(pair_set(val_pairs))\n",
    "assert pair_set(train_pairs).isdisjoint(pair_set(test_pairs))\n",
    "assert pair_set(val_pairs).isdisjoint(pair_set(test_pairs))\n",
    "\n",
    "for name, data in [\n",
    "    (\"Training\", train_pairs),\n",
    "    (\"Validation\", val_pairs),\n",
    "    (\"Testing\", test_pairs)\n",
    "]:\n",
    "    print(f\"\\n{name}: {len(data):,} pairs\")\n",
    "    print(data[\"interaction\"].value_counts().sort_index())\n",
    "\n",
    "print(\"\\nPassed: no overlapping pairs between splits.\")"
   ]
  },
