    "import torch_geometric\n",
    "from torch_geometric.nn import GCNConv\n",
    "\n",
    "print(\"PyTorch Geometric version:\", torch_geometric.__version__)\n",
    "\n",
    "# Check that a graph convolution works\n",
    "sample_features = torch.randn(3, 4)\n",
    "\n",
    "sample_edges = torch.tensor(\n",
    "    [[0, 1, 1, 2],\n",
    "     [1, 0, 2, 1]],\n",
    "    dtype=torch.long\n",
    ")\n",
    "\n",
    "sample_layer = GCNConv(4, 2)\n",
    "sample_output = sample_layer(sample_features, sample_edges)\n",
    "\n",
    "print(\"Output shape:\", tuple(sample_output.shape))\n",
    "print(\"GNN setup check passed.\")"
   ]
