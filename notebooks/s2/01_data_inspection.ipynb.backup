   ],
   "source": [
    "# Get each drug's structure from both DrugBank columns\n",
    "mapping1 = drugbank[[\"ID1\", \"X1\"]].rename(\n",
    "    columns={\"ID1\": \"drug_id\", \"X1\": \"smiles\"}\n",
    ")\n",
    "\n",
    "mapping2 = drugbank[[\"ID2\", \"X2\"]].rename(\n",
    "    columns={\"ID2\": \"drug_id\", \"X2\": \"smiles\"}\n",
    ")\n",
    "\n",
    "drug_mapping = pd.concat(\n",
    "    [mapping1, mapping2], ignore_index=True\n",
    ").drop_duplicates()\n",
    "\n",
    "# Check whether any drug ID has multiple structure strings\n",
    "structure_counts = drug_mapping.groupby(\"drug_id\")[\"smiles\"].nunique()\n",
    "conflicts = structure_counts[structure_counts > 1]\n",
    "\n",
    "print(\"Drugs with multiple SMILES strings:\", len(conflicts))\n",
    "print(\"Drugs with available SMILES:\", drug_mapping[\"drug_id\"].nunique())\n",
    "\n",
    "# Find drugs in the merged pairs without a structure mapping\n",
    "all_drugs = (\n",
    "    set(positive_pairs[\"drug1_id\"])\n",
    "    | set(positive_pairs[\"drug2_id\"])\n",
    ")\n",
    "\n",
    "missing_drugs = all_drugs - set(drug_mapping[\"drug_id\"])\n",
    "\n",
    "print(\"Total drugs in merged pairs:\", len(all_drugs))\n",
    "print(\"Drugs without SMILES:\", len(missing_drugs))\n",
    "\n",
    "display(drug_mapping.head())"
