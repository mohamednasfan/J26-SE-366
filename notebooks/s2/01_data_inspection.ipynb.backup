   "source": [
    "from pathlib import Path\n",
    "import json\n",
    "import numpy as np\n",
    "\n",
    "output_dir = Path(\"data/processed\")\n",
    "output_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Save the exact splits\n",
    "train_pairs.to_csv(output_dir / \"train_pairs.csv\", index=False)\n",
    "val_pairs.to_csv(output_dir / \"validation_pairs.csv\", index=False)\n",
    "test_pairs.to_csv(output_dir / \"test_pairs.csv\", index=False)\n",
    "\n",
    "# Save each drug's fingerprint\n",
    "drug_ids = sorted(fingerprints)\n",
    "\n",
    "np.savez_compressed(\n",
    "    output_dir / \"drug_fingerprints.npz\",\n",
    "    drug_ids=np.array(drug_ids),\n",
    "    fingerprints=np.stack([fingerprints[d] for d in drug_ids])\n",
    ")\n",
    "\n",
    "# Record how this experiment was prepared\n",
    "settings = {\n",
    "    \"random_seed\": 42,\n",
    "    \"split_type\": \"standard_pair_split\",\n",
    "    \"split_proportions\": [0.70, 0.15, 0.15],\n",
    "    \"fingerprint\": \"Morgan\",\n",
    "    \"radius\": 2,\n",
    "    \"fingerprint_size\": 2048,\n",
    "    \"negative_class\": \"sampled unknown pairs, not confirmed non-interactions\",\n",
    "    \"positive_to_negative_ratio\": \"1:1\",\n",
    "    \"train_rows\": len(train_pairs),\n",
    "    \"validation_rows\": len(val_pairs),\n",
    "    \"test_rows\": len(test_pairs)\n",
    "}\n",
    "\n",
    "with open(output_dir / \"experiment_settings.json\", \"w\") as file:\n",
    "    json.dump(settings, file, indent=2)\n",
    "\n",
    "print(\"Saved successfully to:\", output_dir.resolve())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "9b8a90a1-d4a5-4811-a7e0-56778ab0f450",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training feature shape: (274810, 4096)\n",
      "Training label shape: (274810,)\n",
      "Training features saved successfully.\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "from scipy.sparse import csr_matrix, vstack, save_npz\n",
    "\n",
    "def build_pair_features(pairs, batch_size=2000):\n",
    "    batches = []\n",
    "\n",
    "    for start in range(0, len(pairs), batch_size):\n",
    "        batch = pairs.iloc[start:start + batch_size]\n",
    "\n",
    "        # Signed integers prevent errors when subtracting binary values\n",
    "        fp_a = np.stack([\n",
    "            fingerprints[d] for d in batch[\"drug1_id\"]\n",
    "        ]).astype(np.int8)\n",
    "\n",
    "        fp_b = np.stack([\n",
    "            fingerprints[d] for d in batch[\"drug2_id\"]\n",
    "        ]).astype(np.int8)\n",
    "\n",
    "        features = np.concatenate(\n",
    "            [fp_a + fp_b, np.abs(fp_a - fp_b)],\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "        batches.append(csr_matrix(features))\n",
    "\n",
    "    return vstack(batches, format=\"csr\")\n",
    "\n",
    "# Build training features only for now\n",
    "X_train = build_pair_features(train_pairs)\n",
    "y_train = train_pairs[\"interaction\"].to_numpy(dtype=np.int8)\n",
    "\n",
    "print(\"Training feature shape:\", X_train.shape)\n",
    "print(\"Training label shape:\", y_train.shape)\n",
    "\n",
    "assert X_train.shape == (len(train_pairs), 4096)\n",
    "assert X_train.data.min() >= 0\n",
    "assert X_train.data.max() <= 2\n",
    "\n",
    "# Save features and labels in matching row order\n",
    "save_npz(output_dir / \"X_train.npz\", X_train)\n",
    "np.save(output_dir / \"y_train.npy\", y_train)\n",
    "\n",
    "print(\"Training features saved successfully.\")"
   ]
  },
  {
   "cell_type": "code",
