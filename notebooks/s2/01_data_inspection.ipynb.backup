   "id": "9fdfffc9-fb6d-464e-a05d-5fe13b9c8256",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Drugs with fingerprints: 1705\n",
      "Example drug: DB04571\n",
