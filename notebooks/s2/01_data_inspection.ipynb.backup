    "# Give each drug a numerical node index\n",
    "gnn_drug_ids = sorted(fingerprints)\n",
    "drug_to_node = {\n",
    "    drug_id: index\n",
    "    for index, drug_id in enumerate(gnn_drug_ids)\n",
    "}\n",
    "\n",
    "# Node features: molecular fingerprints\n",
    "node_features = torch.tensor(\n",
    "    np.stack([fingerprints[d] for d in gnn_drug_ids]),\n",
    "    dtype=torch.float32\n",
    ")\n",
    "\n",
    "# Separate positive and sampled-unknown training pairs\n",
    "training_positives = train_pairs[\n",
    "    train_pairs[\"interaction\"] == 1\n",
    "].copy()\n",
    "\n",
    "training_unknowns = train_pairs[\n",
    "    train_pairs[\"interaction\"] == 0\n",
    "].copy()\n",
    "\n",
    "# Split training positives into graph edges and prediction targets\n",
    "graph_positives, supervision_positives = train_test_split(\n",
    "    training_positives,\n",
    "    test_size=0.30,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "# Convert drug IDs to node indices\n",
    "def node_pairs(data):\n",
    "    return torch.tensor(\n",
    "        [\n",
    "            data[\"drug1_id\"].map(drug_to_node).to_numpy(),\n",
    "            data[\"drug2_id\"].map(drug_to_node).to_numpy()\n",
    "        ],\n",
    "        dtype=torch.long\n",
    "    )\n",
    "\n",
    "# Add both directions for an undirected interaction graph\n",
    "forward_edges = node_pairs(graph_positives)\n",
    "edge_index = torch.cat(\n",
    "    [forward_edges, forward_edges.flip(0)],\n",
    "    dim=1\n",
    ")\n",
    "\n",
    "# Check that supervised, validation, and test pairs are absent\n",
    "graph_pairs = pair_set(graph_positives)\n",
    "\n",
    "assert graph_pairs.isdisjoint(pair_set(supervision_positives))\n",
    "assert graph_pairs.isdisjoint(pair_set(val_pairs))\n",
    "assert graph_pairs.isdisjoint(pair_set(test_pairs))\n",
    "\n",
    "print(\"Drug nodes:\", len(gnn_drug_ids))\n",
    "print(\"Node feature shape:\", tuple(node_features.shape))\n",
    "print(\"Known interaction pairs in graph:\", len(graph_positives))\n",
    "print(\"Positive training targets:\", len(supervision_positives))\n",
    "print(\"Available unknown training targets:\", len(training_unknowns))\n",
    "print(\"Graph overlap checks passed.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "91cb27de-e60b-4b77-94f0-8ade69e691d8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Drug embedding shape: (1705, 32)\n",
      "Example prediction shape: (5,)\n",
      "Model check passed.\n"
     ]
    }
   ],
   "source": [
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch_geometric.nn import GCNConv\n",
    "\n",
    "torch.manual_seed(42)\n",
    "\n",
    "class DrugInteractionGNN(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "        self.conv1 = GCNConv(2048, 64)\n",
    "        self.conv2 = GCNConv(64, 32)\n",
    "\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Linear(64, 32),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.2),\n",
    "            nn.Linear(32, 1)\n",
    "        )\n",
    "\n",
    "    def encode(self, features, edges):\n",
    "        embeddings = F.relu(self.conv1(features, edges))\n",
    "        embeddings = F.dropout(\n",
    "            embeddings, p=0.2, training=self.training\n",
    "        )\n",
    "        return self.conv2(embeddings, edges)\n",
    "\n",
    "    def decode(self, embeddings, pairs):\n",
    "        drug_a = embeddings[pairs[0]]\n",
    "        drug_b = embeddings[pairs[1]]\n",
    "\n",
    "        # Same prediction features for Aâ€“B and Bâ€“A\n",
    "        pair_features = torch.cat(\n",
    "            [drug_a + drug_b, torch.abs(drug_a - drug_b)],\n",
    "            dim=1\n",
    "        )\n",
    "\n",
    "        return self.classifier(pair_features).squeeze(-1)\n",
    "\n",
    "\n",
    "gnn_model = DrugInteractionGNN()\n",
    "\n",
    "# Check output using five training targets\n",
    "gnn_model.eval()\n",
    "\n",
    "with torch.no_grad():\n",
    "    embeddings = gnn_model.encode(node_features, edge_index)\n",
    "    example_pairs = node_pairs(supervision_positives.head(5))\n",
    "    example_logits = gnn_model.decode(embeddings, example_pairs)\n",
    "\n",
    "print(\"Drug embedding shape:\", tuple(embeddings.shape))\n",
    "print(\"Example prediction shape:\", tuple(example_logits.shape))\n",
    "print(\"Model check passed.\")"
   ]
  },
