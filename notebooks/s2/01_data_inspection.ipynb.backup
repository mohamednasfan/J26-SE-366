   ],
   "source": [
    "# Prepare test features\n",
    "X_test = build_pair_features(test_pairs)\n",
    "y_test = test_pairs[\"interaction\"].to_numpy(dtype=np.int8)\n",
    "\n",
    "# Classical model predictions\n",
    "test_scores = {\n",
    "    \"Logistic Regression\": lr_model.predict_proba(X_test)[:, 1],\n",
    "    \"Random Forest\": rf_model.predict_proba(X_test)[:, 1],\n",
    "    \"XGBoost\": xgb_model.predict_proba(X_test)[:, 1]\n",
    "}\n",
    "\n",
    "# GNN predictions using the unchanged training graph\n",
    "gnn_model.eval()\n",
    "\n",
    "with torch.no_grad():\n",
    "    embeddings = gnn_model.encode(node_features, edge_index)\n",
    "    test_logits = gnn_model.decode(\n",
    "        embeddings, node_pairs(test_pairs)\n",
    "    )\n",
    "    test_scores[\"GNN\"] = torch.sigmoid(test_logits).cpu().numpy()\n",
    "\n",
    "# Evaluate using thresholds already selected on validation data\n",
    "test_rows = []\n",
    "test_predictions = test_pairs[\n",
    "    [\"drug1_id\", \"drug2_id\", \"interaction\"]\n",
    "].copy()\n",
    "\n",
    "for name, scores in test_scores.items():\n",
    "    threshold = selected_thresholds[name]\n",
    "    predictions = (scores >= threshold).astype(int)\n",
    "\n",
    "    tn, fp, fn, tp = confusion_matrix(\n",
    "        y_test, predictions, labels=[0, 1]\n",
    "    ).ravel()\n",
    "\n",
    "    test_rows.append({\n",
    "        \"model\": name,\n",
    "        \"threshold\": threshold,\n",
    "        \"accuracy\": accuracy_score(y_test, predictions),\n",
    "        \"precision\": precision_score(\n",
    "            y_test, predictions, zero_division=0\n",
    "        ),\n",
    "        \"recall\": recall_score(\n",
    "            y_test, predictions, zero_division=0\n",
    "        ),\n",
    "        \"F1\": f1_score(y_test, predictions, zero_division=0),\n",
    "        \"ROC_AUC\": roc_auc_score(y_test, scores),\n",
    "        \"average_precision\": average_precision_score(y_test, scores),\n",
    "        \"missed_known_interactions\": int(fn),\n",
    "        \"unknown_pairs_flagged\": int(fp)\n",
    "    })\n",
    "\n",
    "    test_predictions[f\"{name}_score\"] = scores\n",
    "    test_predictions[f\"{name}_prediction\"] = predictions\n",
    "\n",
    "test_results = pd.DataFrame(test_rows)\n",
    "display(test_results.round(4))\n",
    "\n",
    "test_results.to_csv(\n",
    "    results_dir / \"standard_test_results.csv\", index=False\n",
    ")\n",
    "test_predictions.to_csv(\n",
    "    results_dir / \"standard_test_predictions.csv\", index=False\n",
    ")\n",
    "\n",
    "print(\"Standard test results saved.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "d6f1c7c0-4737-4cbf-972c-d16869fb5203",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training drugs: 1193\n",
      "Validation-only held-out drugs: 256\n",
      "Test-only held-out drugs: 256\n",
      "Passed: all three drug groups are disjoint.\n"
     ]
    }
   ],
   "source": [
    "# Use only drugs present in the prepared binary dataset\n",
    "cold_drugs = sorted(\n",
    "    set(binary_dataset[\"drug1_id\"])\n",
    "    | set(binary_dataset[\"drug2_id\"])\n",
    ")\n",
    "\n",
    "cold_train_drugs, cold_remaining_drugs = train_test_split(\n",
    "    cold_drugs,\n",
    "    test_size=0.30,\n",
    "    random_state=123\n",
    ")\n",
    "\n",
    "cold_val_drugs, cold_test_drugs = train_test_split(\n",
    "    cold_remaining_drugs,\n",
    "    test_size=0.50,\n",
    "    random_state=123\n",
    ")\n",
    "\n",
    "cold_train_drugs = set(cold_train_drugs)\n",
    "cold_val_drugs = set(cold_val_drugs)\n",
    "cold_test_drugs = set(cold_test_drugs)\n",
    "\n",
    "assert cold_train_drugs.isdisjoint(cold_val_drugs)\n",
    "assert cold_train_drugs.isdisjoint(cold_test_drugs)\n",
    "assert cold_val_drugs.isdisjoint(cold_test_drugs)\n",
    "\n",
    "print(\"Training drugs:\", len(cold_train_drugs))\n",
    "print(\"Validation-only held-out drugs:\", len(cold_val_drugs))\n",
    "print(\"Test-only held-out drugs:\", len(cold_test_drugs))\n",
    "print(\"Passed: all three drug groups are disjoint.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "c486e9d5-a3dc-4d29-b0c4-2d09b2eebaeb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Cold-start training: 190,916 pairs\n",
      "interaction\n",
      "0    95831\n",
      "1    95085\n",
      "Name: count, dtype: int64\n",
      "\n",
      "Cold-start validation: 84,628 pairs\n",
      "interaction\n",
      "0    41468\n",
      "1    43160\n",
      "Name: count, dtype: int64\n",
      "\n",
      "Cold-start testing: 81,640 pairs\n",
      "interaction\n",
      "0    41535\n",
      "1    40105\n",
      "Name: count, dtype: int64\n",
      "\n",
      "Pairs excluded from this protocol: 35402\n",
      "Cold-start separation checks passed.\n",
      "Cold-start splits saved.\n"
     ]
    }
   ],
   "source": [
    "a = binary_dataset[\"drug1_id\"]\n",
    "b = binary_dataset[\"drug2_id\"]\n",
    "\n",
    "train_mask = (\n",
    "    a.isin(cold_train_drugs)\n",
    "    & b.isin(cold_train_drugs)\n",
    ")\n",
    "\n",
    "val_mask = (\n",
    "    (a.isin(cold_train_drugs) & b.isin(cold_val_drugs))\n",
    "    | (a.isin(cold_val_drugs) & b.isin(cold_train_drugs))\n",
    ")\n",
    "\n",
    "test_mask = (\n",
    "    (a.isin(cold_train_drugs) & b.isin(cold_test_drugs))\n",
    "    | (a.isin(cold_test_drugs) & b.isin(cold_train_drugs))\n",
    ")\n",
    "\n",
    "cold_train_pairs = binary_dataset[train_mask].copy()\n",
    "cold_val_pairs = binary_dataset[val_mask].copy()\n",
    "cold_test_pairs = binary_dataset[test_mask].copy()\n",
    "\n",
    "# Check that held-out drugs never appear in training\n",
    "actual_training_drugs = (\n",
    "    set(cold_train_pairs[\"drug1_id\"])\n",
    "    | set(cold_train_pairs[\"drug2_id\"])\n",
    ")\n",
    "\n",
    "assert actual_training_drugs.isdisjoint(cold_val_drugs)\n",
    "assert actual_training_drugs.isdisjoint(cold_test_drugs)\n",
    "\n",
    "# Check pair separation\n",
    "assert pair_set(cold_train_pairs).isdisjoint(pair_set(cold_val_pairs))\n",
    "assert pair_set(cold_train_pairs).isdisjoint(pair_set(cold_test_pairs))\n",
    "assert pair_set(cold_val_pairs).isdisjoint(pair_set(cold_test_pairs))\n",
    "\n",
    "for name, data in [\n",
    "    (\"Cold-start training\", cold_train_pairs),\n",
    "    (\"Cold-start validation\", cold_val_pairs),\n",
    "    (\"Cold-start testing\", cold_test_pairs)\n",
    "]:\n",
    "    print(f\"\\n{name}: {len(data):,} pairs\")\n",
    "    print(data[\"interaction\"].value_counts().sort_index())\n",
    "    assert data[\"interaction\"].nunique() == 2\n",
    "\n",
    "excluded_count = len(binary_dataset) - (\n",
    "    len(cold_train_pairs)\n",
    "    + len(cold_val_pairs)\n",
    "    + len(cold_test_pairs)\n",
    ")\n",
    "\n",
    "print(\"\\nPairs excluded from this protocol:\", excluded_count)\n",
    "print(\"Cold-start separation checks passed.\")\n",
    "\n",
    "# Save separately from the standard experiment\n",
    "cold_output_dir = Path(\"data/processed/cold_start\")\n",
    "cold_output_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "cold_train_pairs.to_csv(\n",
    "    cold_output_dir / \"train_pairs.csv\", index=False\n",
    ")\n",
    "cold_val_pairs.to_csv(\n",
    "    cold_output_dir / \"validation_pairs.csv\", index=False\n",
    ")\n",
    "cold_test_pairs.to_csv(\n",
    "    cold_output_dir / \"test_pairs.csv\", index=False\n",
    ")\n",
    "\n",
    "with open(cold_output_dir / \"drug_groups.json\", \"w\") as file:\n",
    "    json.dump({\n",
    "        \"seed\": 123,\n",
    "        \"protocol\": \"one_unseen_drug\",\n",
    "        \"training_drugs\": sorted(cold_train_drugs),\n",
    "        \"validation_drugs\": sorted(cold_val_drugs),\n",
    "        \"test_drugs\": sorted(cold_test_drugs)\n",
    "    }, file, indent=2)\n",
    "\n",
    "print(\"Cold-start splits saved.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "003ef536-2577-4c6b-9101-e90ade184098",
   "metadata": {},
   "outputs": [
