   ],
   "source": [
    "# Prepare DrugBank pairs.\n",
    "# Keep the original Y categories in the original drugbank dataframe.\n",
    "db_pairs = drugbank[[\"ID1\", \"ID2\"]].rename(\n",
    "    columns={\"ID1\": \"drug1_id\", \"ID2\": \"drug2_id\"}\n",
    ").copy()\n",
    "\n",
    "db_pairs[\"interaction\"] = 1\n",
    "db_pairs[\"source\"] = \"DrugBank\"\n",
    "\n",
    "# Prepare BIOSNAP pairs\n",
    "bio_pairs = biosnap[[\"Drug1\", \"Drug2\", \"label\"]].rename(\n",
    "    columns={\n",
    "        \"Drug1\": \"drug1_id\",\n",
    "        \"Drug2\": \"drug2_id\",\n",
    "        \"label\": \"interaction\"\n",
    "    }\n",
    ").copy()\n",
    "\n",
    "bio_pairs[\"source\"] = \"BIOSNAP\"\n",
    "\n",
    "# Combine both sources\n",
    "combined = pd.concat([db_pairs, bio_pairs], ignore_index=True)\n",
    "\n",
    "# Remove surrounding spaces from IDs\n",
    "for column in [\"drug1_id\", \"drug2_id\"]:\n",
    "    combined[column] = combined[column].str.strip()\n",
    "\n",
    "# For binary interaction prediction, Aâ€“B and Bâ€“A are the same pair.\n",
    "ordered_pairs = combined[[\"drug1_id\", \"drug2_id\"]].apply(\n",
    "    sorted, axis=1, result_type=\"expand\"\n",
    ")\n",
    "combined[\"drug1_id\"] = ordered_pairs[0]\n",
    "combined[\"drug2_id\"] = ordered_pairs[1]\n",
    "\n",
    "# Merge repeated pairs while retaining their sources\n",
    "positive_pairs = combined.groupby(\n",
    "    [\"drug1_id\", \"drug2_id\"], as_index=False\n",
    ").agg(\n",
    "    interaction=(\"interaction\", \"first\"),\n",
    "    source=(\"source\", lambda values: \"+\".join(sorted(set(values))))\n",
    ")\n",
    "\n",
    "print(\"Rows before removing repeated pairs:\", len(combined))\n",
    "print(\"Unique known interaction pairs:\", len(positive_pairs))\n",
    "print(\"\\nSources:\")\n",
    "print(positive_pairs[\"source\"].value_counts())\n",
    "\n",
    "display(positive_pairs.head())"
   ]
  },
